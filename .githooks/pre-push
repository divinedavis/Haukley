#!/usr/bin/env bash
# Runs before every `git push` from this checkout (installed by scripts/install_hooks.sh).
# This repo is private and has NO GitHub Actions on purpose (nothing that can bill), so
# this hook is the CI:
#   1. gitleaks over exactly the commits being pushed, so no credential leaves the Mac;
#   2. tests/run_fast.sh (tsc, jest, Python catalog/page checks, Roku unit tests; ~10 s).
# Emergency bypass: git push --no-verify (say why in the next commit body).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
ZERO=0000000000000000000000000000000000000000
GITLEAKS=$(command -v gitleaks || echo /opt/homebrew/bin/gitleaks)
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue            # deleting a branch
  if [ "$remote_sha" = "$ZERO" ]; then range="$local_sha --not --remotes"; else range="$remote_sha..$local_sha"; fi
  if [ -x "$GITLEAKS" ]; then
    "$GITLEAKS" git --no-banner --redact --log-opts="$range" >/dev/null 2>&1 || {
      echo "pre-push: gitleaks found a secret in $range; run: gitleaks git --log-opts=\"$range\" -v" >&2; exit 1; }
  else
    echo "pre-push: gitleaks not installed (brew install gitleaks); secrets scan SKIPPED" >&2
  fi
done
log=$(mktemp)
tests/run_fast.sh >"$log" 2>&1 || {
  cat "$log" >&2; echo "pre-push: fast tests failed (tests/run_fast.sh)" >&2; exit 1; }
rm -f "$log"
echo "pre-push: secrets scan + fast tests passed"
