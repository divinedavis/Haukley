<?xml version="1.0" encoding="utf-8" ?>
<!-- One piece of artwork in a RowList: poster or landscape card, with an
     Apple TV-style lift + white focus ring and labels underneath. -->
<component name="TitleItem" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContent" />
        <field id="width" type="float" onChange="onSize" />
        <field id="height" type="float" onChange="onSize" />
        <field id="focusPercent" type="float" onChange="onFocus" />
        <field id="rowListHasFocus" type="boolean" onChange="onFocus" />
    </interface>
    <script type="text/brightscript" uri="TitleItem.brs" />
    <children>
        <Group id="art">
            <Rectangle id="ring" color="0xFFFFFFFF" opacity="0" />
            <Rectangle id="placeholder" color="0x1C1C1EFF" />
            <Poster id="poster" loadDisplayMode="scaleToFill" />
            <Rectangle id="progTrack" color="0xFFFFFF4D" height="6" visible="false" />
            <Rectangle id="progFill" color="0xFFFFFFFF" height="6" visible="false" />
        </Group>
        <Label id="rank" color="0xFFFFFFFF" visible="false">
            <Font role="font" uri="pkg:/fonts/Poppins-Bold.ttf" size="44" />
        </Label>
        <Label id="label" color="0xFFFFFF9E" horizAlign="left">
            <Font role="font" uri="pkg:/fonts/Poppins-Bold.ttf" size="24" />
        </Label>
        <Label id="sub" color="0xFFFFFF66" horizAlign="left">
            <Font role="font" uri="pkg:/fonts/Poppins-Regular.ttf" size="20" />
        </Label>
    </children>
</component>
