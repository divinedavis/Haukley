<?xml version="1.0" encoding="utf-8" ?>
<!-- Plays one title. RAF ads (pre/mid/post-roll + ad events for the filmmaker split) are
     off while the Roku listing is non-monetized; see PlayerTask.brs. -->
<component name="PlayerTask" extends="Task">
    <interface>
        <field id="video" type="node" />
        <field id="adUrl" type="string" />
        <field id="titleId" type="string" />
        <field id="genre" type="string" />
        <field id="episode" type="integer" />
        <field id="contentLength" type="integer" />
        <field id="bookmark" type="boolean" value="true" />
        <field id="trackingUrl" type="string" />
        <field id="apiKey" type="string" />
        <field id="done" type="boolean" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="PlayerTask.brs" />
    <script type="text/brightscript" uri="Content.brs" />
</component>
